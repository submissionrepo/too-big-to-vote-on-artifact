[{"id": "510065", "question": "Will Trump say \"China\" 10 or more times during Pennsylvania rally on October 19?", "conditionId": "0xd4fdd616eafd8fd0f5329c72c41426d20b70d0f97cc8dd5e27e69f84c4f0637e", "slug": "will-trump-say-china-10-or-more-times-during-pennsylvania-rally-on-october-19", "resolutionSource": "", "endDate": "2024-10-19T12:00:00Z", "startDate": "2024-10-17T20:49:45.347421Z", "image": "https://polymarket-upload.s3.us-east-2.amazonaws.com/what-will-trump-say-during-pennsylvania-rally-oct-19-QfunW3j0R8cW.jpg", "icon": "https://polymarket-upload.s3.us-east-2.amazonaws.com/what-will-trump-say-during-pennsylvania-rally-oct-19-QfunW3j0R8cW.jpg", "description": "Donald Trump has scheduled a rally on October 19 in Latrobe, Pennsylvania (see: https://event.donaldjtrump.com/events/president-donald-j-trump-to-hold-a-rally-in-latrobe-pennsylvania).\n\nThis market will resolve to \"Yes\" if Trump says \"China\" 10 or more times during their appearance at this event. Otherwise, the market will resolve to \"No\".\n\nAny usage of the term regardless of context will count toward the resolution of this market.\n\nPluralization/possessive of the term will count toward the resolution of this market, however other forms will NOT count.\n\nCompound words will count as long as \"China\" is part of the compound word and references the meaning which refers to the East Asian country officially named the People's Republic of China.\n\nIf this candidate does not appear at this event, or if the event is otherwise cancelled or delayed beyond October 19, this market will resolve to \"No\".\n\nThe resolution source will be the video of the event.", "outcomes": "[\"Yes\", \"No\"]", "outcomePrices": "[\"1\", \"0\"]", "volume": "173792.91634", "active": true, "closed": true, "marketMakerAddress": "", "createdAt": "2024-10-17T17:35:15.779839Z", "updatedAt": "2024-10-21T01:36:46.335523Z", "closedTime": "2024-10-20 01:58:53+00", "new": false, "featured": false, "submitted_by": "0x91430CaD2